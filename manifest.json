{
  "manifest_version": 3,
  "name": "AuraTab",
  "description": "A beautiful new tab page with random wallpapers, a live clock, and Google search.",  
  "version": "1.0",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*"
  ]
}